# Frontend Environment Configuration Example
# Copy this file to .env.local and update the values for your environment

# Backend API Endpoint - Update this to your backend URL
# Local development typically uses http://localhost:8000
# Production would use your deployed backend URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Ollama Configuration (if needed on frontend)
# Update this if Ollama is running on a different host or port
NEXT_PUBLIC_OLLAMA_URL=http://localhost:11434
