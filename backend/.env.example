API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000

UPLOAD_DIR=./uploads
RESULTS_DIR=./results
LOGS_DIR=./logs
MAX_FILE_SIZE=52428800

JOB_TIMEOUT=1800
CLEANUP_DAYS=7

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

LOG_LEVEL=INFO
DEBUG=False

# ⚠️ MONGODB CONFIGURATION - NEVER COMMIT ACTUAL CREDENTIALS
# This file is your template. Your actual .env (NOT committed to git) should contain:
#
# Option 1: LOCAL MONGODB (Testing)
# MONGODB_URL=mongodb://localhost:27017
#
# Option 2: MONGODB ATLAS (Production)
# Instructions:
#   1. Go to https://cloud.mongodb.com and log in
#   2. Click "Connect" on your cluster
#   3. Choose "Drivers" and copy the connection string
#   4. Replace <username> and <password> with your credentials
#   5. Paste into your LOCAL .env file (NOT .env.example)
#
# MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority&appName=Cluster0
#
# ⚠️ SECURITY REMINDER:
# - MONGODB_URL contains sensitive authentication credentials
# - NEVER commit .env or .env.local to git
# - .env must be in .gitignore and on all .gitignore files
# - Use strong passwords (16+ characters with special characters)
# - Rotate credentials regularly
# - Use environment secrets in production (AWS Secrets Manager, GitHub Secrets, etc)

MONGODB_URL=[YOUR_CONNECTION_STRING_HERE]
MONGODB_DATABASE=mat_extract_ai
USE_MONGODB=True
